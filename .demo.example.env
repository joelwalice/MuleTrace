# Copy to .demo.env (git-ignored) and fill in the placeholders. Read by demo-mac.sh.
PUBLIC_URL=https://rj2pcsz0-8000.inc1.devtunnels.ms   # Copilot Studio calls the API here (/mcp)
TUNNEL=muletrace-mac                                   # this laptop's own dev tunnel (one host per tunnel)
PLAYBOOK_WEBHOOK='<Power Automate "MuleTrace Dismantle Playbook" HTTP trigger URL: it contains a key>'
# Optional
# FOUNDRY_SCORING_URL=<Azure ML endpoint scoring URL>
# FOUNDRY_KEY=<Azure ML endpoint key>
# MCP_KEY=<shared secret; Copilot then sends it as x-api-key>
